# OpenTenBase Connection
DB_HOST=otb-node1
DB_PORT=11003
DB_USER=opentenbase
DB_NAME=postgres
DB_PASSWORD=

# DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
AIOPS_APPROVAL_TOKEN=
AIOPS_APPROVER_ID=local-operator
AIOPS_AUTO_AUDIT_ENABLED=false
AIOPS_AUTO_AUDIT_INTERVAL_SECONDS=900
AIOPS_AUTO_AUDIT_TABLE=

# Vector Store
CHROMA_PERSIST_DIRECTORY=./data/embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Monitoring Settings
HEALTH_CHECK_INTERVAL=60
SLOW_QUERY_THRESHOLD_MS=1000

# SiliconFlow embeddings
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
