# OpenTenBase Connection
DB_HOST=otb-node1
DB_PORT=11003
DB_USER=opentenbase
DB_NAME=postgres
DB_PASSWORD=

# DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AIOPS_SAFETY_REVIEW_MODEL=
# Optional independent safety-review endpoint. Empty values reuse the DeepSeek endpoint.
AIOPS_SAFETY_REVIEW_API_KEY=
AIOPS_SAFETY_REVIEW_API_BASE=
AIOPS_SAFETY_REVIEW_PROVIDER=
DEEPSEEK_TIMEOUT_SECONDS=150
# Allow time for collection, multiple model calls and knowledge retrieval.
AIOPS_HEALTH_AUDIT_HTTP_TIMEOUT_SECONDS=210
# Bound read-only collection latency. Lock waits can be raised for slower or busier clusters.
AIOPS_COLLECTION_STATEMENT_TIMEOUT_MS=2500
AIOPS_COLLECTION_LOCK_TIMEOUT_MS=750
# Minimum prepared-transaction age for the optional official pg_clean diagnostic.
AIOPS_PG_CLEAN_MIN_AGE_SECONDS=10

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
# Optional Bearer API key for all /api/* routes. Keep empty only for isolated local development.
AIOPS_API_KEY=
# Optional shared Streamlit login password. Keep empty only for isolated local development.
AIOPS_UI_PASSWORD=
# Restrict browser origins when exposing the API outside the local machine.
AIOPS_CORS_ORIGINS=*
AIOPS_APPROVAL_TOKEN=
# Optional separate OpenTenBase login for approved repair execution.
AIOPS_REPAIR_DB_USER=
AIOPS_REPAIR_DB_PASSWORD=
# Explicitly enable the reviewed per-DN pg_cancel_backend executor only after a lab probe.
AIOPS_CANCEL_QUERY_ENABLED=false
# Optional administrator-installed SECURITY DEFINER function for least-privilege ANALYZE.
AIOPS_REPAIR_FUNCTION_ENABLED=false
AIOPS_REPAIR_FUNCTION_SCHEMA=aiops_admin
AIOPS_REPAIR_FUNCTION_NAME=analyze_table
AIOPS_AUTO_REPAIR_ENABLED=false
# Scheduled automatic ANALYZE requires explicit schema.table targets.
AIOPS_AUTO_REPAIR_TARGETS=
# Optional JSON object of operator IDs mapped to distinct tokens. Overrides the shared token.
AIOPS_APPROVER_TOKENS=
AIOPS_APPROVER_ID=local-operator
# Stable per API replica identity, unique while replicas overlap during a rollout.
AIOPS_INSTANCE_ID=opentenbase-aiops-api
AIOPS_AUTO_AUDIT_ENABLED=true
AIOPS_AUTO_AUDIT_INTERVAL_SECONDS=900
# Failed scheduled audits retry exponentially, capped by this value and the audit interval.
AIOPS_AUTO_AUDIT_RETRY_MAX_SECONDS=3600
AIOPS_AUTO_AUDIT_TABLE=
AIOPS_DATA_NODE_TABLE_LIMIT=200
AIOPS_SLOW_QUERY_LOG_LOOKBACK_SECONDS=900
AIOPS_SLOW_QUERY_REDACT_LITERALS=true
# Optional profile-based metadata backup schedule, interval >= 60 and retention >= 1.
AIOPS_METADATA_BACKUP_INTERVAL_SECONDS=86400
AIOPS_METADATA_BACKUP_RETENTION_DAYS=30

# Vector Store
CHROMA_PERSIST_DIRECTORY=./data/embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Monitoring Settings
HEALTH_CHECK_INTERVAL=60
SLOW_QUERY_THRESHOLD_MS=1000

# SiliconFlow embeddings
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
